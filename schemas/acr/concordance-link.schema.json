{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/regis/acr/concordance-link.schema.json",
  "title": "ConcordanceLink",
  "type": "object",
  "required": ["concordance_link_id", "schema_version", "policy_version", "source_record_ref", "canonical_entity_ref", "status", "decision_ledger_refs"],
  "properties": {
    "concordance_link_id": {"type": "string"},
    "schema_version": {"type": "string"},
    "policy_version": {"type": "string"},
    "template_version": {"type": "string"},
    "resolver_version": {"type": "string"},
    "source_record_ref": {"type": "string"},
    "canonical_entity_ref": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "pending_review", "rejected", "superseded", "revoked", "disputed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "score": {"type": "number", "minimum": 0},
    "confidence_band": {"type": "string", "enum": ["low", "medium", "high", "exact", "unknown"], "default": "unknown"},
    "resolver_run_id": {"type": "string"},
    "energy_ledger_ref": {"type": "string"},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "default": []},
    "explanation_codes": {"type": "array", "items": {"type": "string"}, "default": []},
    "decision_ledger_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "certificate_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "canonical_mutation": {"type": "boolean", "default": true}
  },
  "additionalProperties": false
}
