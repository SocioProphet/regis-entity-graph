{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/regis/epistemic-edge-record.schema.json",
  "title": "Regis Epistemic Edge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "recordId",
    "createdAt",
    "edgeRef",
    "edgeKind",
    "edgeStatus",
    "epistemicClass",
    "sourceChannel",
    "evidenceRefs",
    "policyDecisionRefs",
    "confidence",
    "promotionState",
    "temporalScope",
    "consumers",
    "review",
    "nonClaims"
  ],
  "properties": {
    "apiVersion": {"const": "regis.entity-graph.epistemic-edge/v1"},
    "kind": {"const": "EpistemicEdgeRecord"},
    "recordId": {"type": "string", "pattern": "^urn:regis:epistemic-edge:[a-z0-9][a-z0-9._:-]*$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "edgeRef": {"type": "string", "minLength": 1},
    "edgeKind": {"type": "string", "minLength": 1},
    "edgeStatus": {"enum": ["PROPOSED", "ACTIVE", "VETOED", "REVOKED", "EXPIRED"]},
    "epistemicClass": {"enum": ["reported_relation", "observed_relation", "extracted_relation", "inferred_relation", "confirmed_relation", "legal_contractual_relation", "operational_relation", "hypothetical_relation", "superseded_relation", "contested_relation"]},
    "sourceChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelRef", "channelClass", "substrate", "captureMethod", "trustBoundary", "knownConfusabilityModes"],
      "properties": {
        "channelRef": {"type": "string", "minLength": 1},
        "channelClass": {"enum": ["human_communication", "machine_observability", "connector", "model_output", "memory_retrieval", "graph_projection", "dashboard_projection", "agent_report", "action_path"]},
        "substrate": {"type": "string", "minLength": 1},
        "captureMethod": {"type": "string", "minLength": 1},
        "trustBoundary": {"enum": ["same_process", "same_workspace", "same_org", "external_authenticated", "external_public", "synthetic", "adversarial_or_unknown"]},
        "knownConfusabilityModes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "perceptRefs": {"type": "array", "items": {"type": "string"}, "default": []},
    "interpretantRefs": {"type": "array", "items": {"type": "string"}, "default": []},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policyDecisionRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidenceType", "level"],
      "properties": {
        "confidenceType": {"enum": ["acoustic", "visual", "semantic", "provenance", "statistical", "operational", "graph_extraction", "model_heuristic", "human_reported", "artifact_verified"]},
        "level": {"enum": ["low", "medium", "high", "unknown"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "promotionState": {"enum": ["raw_observation", "candidate", "confirmed", "contested", "superseded", "expired"]},
    "temporalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validFrom", "validTo", "revalidationRef"],
      "properties": {
        "validFrom": {"type": "string", "format": "date-time"},
        "validTo": {"type": ["string", "null"], "format": "date-time"},
        "revalidationRef": {"type": ["string", "null"]}
      }
    },
    "consumers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "disallowed"],
      "properties": {
        "allowed": {"type": "array", "items": {"$ref": "#/$defs/consumer"}},
        "disallowed": {"type": "array", "items": {"$ref": "#/$defs/consumer"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewerRefs", "approvalRef", "repairEventRefs"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "approved", "rejected", "blocked"]},
        "reviewerRefs": {"type": "array", "items": {"type": "string"}},
        "approvalRef": {"type": ["string", "null"]},
        "repairEventRefs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nonClaims": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "consumer": {"enum": ["search", "traversal", "entity_merge", "export", "policy", "memory_promotion", "dashboard", "agent_action", "legal_or_contract", "publication"]}
  }
}
